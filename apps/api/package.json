{
  "name": "@fplq/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "cf:dev": "wrangler dev",
    "cf:migrations:local": "wrangler d1 migrations apply fplq --local",
    "cf:migrations": "wrangler d1 migrations apply fplq"
  },
  "dependencies": {
    "@fplq/shared": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "dotenv": "^17.4.2",
    "hono": "^4.13.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250801.0",
    "@types/node": "^24.13.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "wrangler": "^4.40.0"
  }
}
